# Copia este archivo como .env y ajusta los valores si lo necesitas.
# Todas las variables tienen un valor por defecto; el servidor arranca sin .env.

# development | test | production
NODE_ENV=development

# Puerto del API
PORT=3001

# Orígenes permitidos por CORS, separados por coma
CLIENT_ORIGIN=http://localhost:5173

# Simula una caída total de la pasarela de pagos (true / false)
SNAILPAY_FORCE_OUTAGE=false

# Retraso en milisegundos que aplica la tarjeta de timeout (debe superar los 10 s del cliente)
SNAILPAY_TIMEOUT_DELAY_MS=15000
